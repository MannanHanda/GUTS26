# Copy to .env to override defaults. Never commit .env (it is git-ignored).
# No secrets are needed yet.

# Browser origins allowed to call the backend
UNIWISE_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# URL the browser uses to reach the backend (baked into the web build)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Later, for Supabase login/registration (public values only; never the service-role key):
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
